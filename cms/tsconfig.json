{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "outDir": "dist"
  },
  "include": ["./", "config/**/*", "src/**/*", "node_modules/@strapi/**/*"],
  "exclude": ["node_modules", ".strapi", ".next-standalone", ".next", "build", "dist"]
}
